# Copie para .env e preencha. Nenhum valor real entra neste arquivo — ele é
# versionado, o .env não.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# URL do projeto e anon key. São públicas de propósito: vão no bundle do painel
# (runtimeConfig.public) e a RLS é quem protege os dados.
SUPABASE_URL=
SUPABASE_KEY=

# service_role: IGNORA a RLS inteira (BYPASSRLS).
#
# Fica fora de runtimeConfig.public de propósito — em `public` ela seria embutida
# no bundle do navegador, e quem abrisse o site teria acesso irrestrito ao banco
# de todos os tenants. Use só em server/, e sempre filtrando por tenant_id à mão.
#
# Sem esta variável, toda escrita pública cai: o formulário de contato para de
# gravar lead e o log grita `config.service_key_missing`.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anti-flood do formulário público
# ---------------------------------------------------------------------------

# Sal do hash de IP usado na segunda trava do formulário de contato.
#
# Opcional, mas o custo de deixar vazio é silencioso: sem sal a trava por IP
# simplesmente NÃO RODA (só sobra a por telefone), e o único sinal é um
# `ratelimit.ip_salt_missing` no log. Vale definir em produção.
#
# Não use um valor previsível: sem sal isto seria sha256(ip), e o espaço IPv4
# inteiro se tabula em minutos — o hash não esconderia nada de quem lesse a
# tabela. Gere com: openssl rand -hex 32
RATE_LIMIT_IP_SALT=

# ---------------------------------------------------------------------------
# Resolução de tenant
# ---------------------------------------------------------------------------

# Fallback de tenant quando o host não resolve (dev, ou domínio não cadastrado
# em tenant_domains). Em dev normalmente é o slug do tenant de trabalho.
NUXT_DEFAULT_TENANT=

# Domínio-base da plataforma: a raiz é a landing, e <slug>.<dominio> resolve o
# tenant pelo slug. Deixe vazio para usar o default do nuxt.config.
NUXT_PLATFORM_DOMAIN=

# ---------------------------------------------------------------------------
# Crédito no rodapé e landing (públicas)
# ---------------------------------------------------------------------------

NUXT_PUBLIC_BUILT_BY_NAME=

# Sem default no código, de propósito: este valor alimenta links reais (crédito
# no rodapé de TODO tenant e os CTAs da landing), então um número inventado
# mandaria os interessados para o WhatsApp de um desconhecido. Vazio, os
# componentes degradam sozinhos. Formato com DDI, só dígitos: 5567999990000
NUXT_PUBLIC_BUILT_BY_WHATSAPP=

NUXT_PUBLIC_DEMO_URL=

# ---------------------------------------------------------------------------
# Não defina à mão
# ---------------------------------------------------------------------------
#
# VERCEL_ENV — a Vercel injeta sozinha. É o que desliga o atalho `?tenant=slug`
# em produção; forçar o valor aqui reabriria a troca de tenant por query param.
