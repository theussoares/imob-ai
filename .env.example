# ─── Supabase ───────────────────────────────────────────────
# Estas são as chaves PÚBLICAS (anon/publishable) — seguras para o client.
# Copie este arquivo para `.env` (`cp .env.example .env`).
SUPABASE_URL=https://eixzfjmmcocuxnprqskf.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVpeHpmam1tY29jdXhucHJxc2tmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0NTYxNDAsImV4cCI6MjEwMjAzMjE0MH0.tLZn6gG1E1ds3bNiHbYc8o3Zw1EEbjov8ueyd2ePki4

# ─── App ────────────────────────────────────────────────────
# Tenant usado como fallback em desenvolvimento (host sem domínio cadastrado).
NUXT_DEFAULT_TENANT=tres-lagoas
# URL pública do site (usada em canonical, sitemap, Open Graph).
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# (Opcional) Domínio-base para resolução por subdomínio: slug.<platform>.
# Ex.: suaplataforma.com.br -> vitrine-imoveis.suaplataforma.com.br.
# Deixe vazio para resolver subdomínio de forma genérica (1º rótulo do host).
NUXT_PLATFORM_DOMAIN=

# ─── Chaves privadas (NUNCA em `public`) ────────────────────
# Service role do Supabase. Necessária para as ESCRITAS públicas (formulários) e,
# desde o WhatsApp do captador, também para as LEITURAS públicas do catálogo —
# sem ela, o site inteiro responde 500, não só os formulários.
SUPABASE_SERVICE_ROLE_KEY=
# Sal do hash de IP no anti-flood dos formulários. Sem isto o hash seria
# sha256(ip) puro, e o espaço IPv4 inteiro se quebra por força bruta em minutos —
# então, vazio, a trava por IP fica DESLIGADA de propósito (e loga um aviso).
# Gere um valor aleatório longo e mantenha estável entre deploys:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_IP_SALT=

# ─── Crédito do desenvolvedor ───────────────────────────────
# Alimenta links wa.me REAIS: o "Desenvolvido por" no rodapé de todo tenant e os
# CTAs da landing da Moradi. Vazio, esses links viram href="#".
NUXT_PUBLIC_BUILT_BY_NAME=
NUXT_PUBLIC_BUILT_BY_WHATSAPP=
